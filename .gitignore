# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
test-results/
playwright-report/
blob-report/
playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/tmp/
.commandcode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example
!**/.env.example

# python / CrewAI
**/__pycache__/
*.py[cod]
*.egg-info/
.venv/
crewai/.venv/
crewai/.crewai/
crewai/.checkpoints/
crewai/output/*
!crewai/output/.gitkeep

# mise local overrides (mise.toml is committed)
mise.local.toml
.mise.local.toml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.agents/skills/

