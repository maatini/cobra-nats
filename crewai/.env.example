# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# Default: OpenAI. CrewAI uses LiteLLM, so any supported provider works.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Alternative model id (overrides OPENAI_MODEL when set). Examples:
#   MODEL=openai/gpt-4o
#   MODEL=anthropic/claude-sonnet-4-5
#   MODEL=groq/llama-3.3-70b-versatile
#   MODEL=ollama/llama3.2
MODEL=

# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# ---------------------------------------------------------------------------
# GitHub (GithubSearchTool — remote repo analysis)
# ---------------------------------------------------------------------------
# Fine-grained or classic PAT with repo read access:
# https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_REPO=https://github.com/maatini/cobra-nats

# ---------------------------------------------------------------------------
# Local checkout
# ---------------------------------------------------------------------------
# Absolute path to the cobra-nats working tree. Defaults to the parent of
# this crewai/ directory when unset.
# REPO_PATH=/absolute/path/to/cobra-nats

# ---------------------------------------------------------------------------
# Crew behaviour
# ---------------------------------------------------------------------------
# hierarchical (default) or sequential
CREW_PROCESS=hierarchical

# Memory uses OpenAI embeddings by default. Set false if you have no OpenAI key.
CREW_MEMORY=true
CREW_PLANNING=true

# CREWAI_DISABLE_TELEMETRY=true
