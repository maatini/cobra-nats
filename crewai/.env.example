# ---------------------------------------------------------------------------
# LLM — OpenRouter (default)
# https://openrouter.ai/keys
# LiteLLM model ids: openrouter/<provider>/<model>
# Catalogue: https://openrouter.ai/models
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Optional OpenRouter attribution headers (shown on openrouter.ai rankings)
# OR_SITE_URL=https://github.com/maatini/cobra-nats
# OR_APP_NAME=cobra-nats-crew

# LiteLLM / CrewAI id MUST start with openrouter/
#   MODEL=openrouter/openai/gpt-4o
#   MODEL=openrouter/openai/gpt-4o-mini
#   MODEL=openrouter/anthropic/claude-sonnet-4.5
#   MODEL=openrouter/google/gemini-2.5-flash
#   MODEL=openrouter/qwen/qwen-2.5-72b-instruct
MODEL=openrouter/openai/gpt-4o

# Do not set OPENAI_API_KEY when using OpenRouter. The crew aliases it
# internally so CrewAI planning does not demand a real OpenAI key.

# ---------------------------------------------------------------------------
# Direct providers (optional — leave unset when using OpenRouter)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OLLAMA_HOST=http://localhost:11434
# MODEL=anthropic/claude-sonnet-4-5
# MODEL=groq/llama-3.3-70b-versatile
# MODEL=ollama/llama3.2

# ---------------------------------------------------------------------------
# GitHub (GithubSearchTool — remote repo analysis)
# ---------------------------------------------------------------------------
# Fine-grained or classic PAT with repo read access:
# https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_REPO=https://github.com/maatini/cobra-nats

# ---------------------------------------------------------------------------
# Local checkout (file-tool sandbox)
# ---------------------------------------------------------------------------
# Absolute path to the cobra-nats working tree. FileReadTool, DirectoryReadTool,
# read_repo_file, list_repo_tree, and grep_repo are confined to this directory.
# Defaults to the parent of this crewai/ folder (the cobra-nats repo root).
# REPO_PATH=/absolute/path/to/cobra-nats

# ---------------------------------------------------------------------------
# Crew behaviour
# ---------------------------------------------------------------------------
# hierarchical (default) or sequential — analysis crew only.
# Implementation mode (`mise run crew:implement`) is always sequential.
CREW_PROCESS=hierarchical

# Memory uses OpenAI embeddings. Keep false on OpenRouter-only setups.
CREW_MEMORY=false
CREW_PLANNING=true

# CREWAI_DISABLE_TELEMETRY=true
